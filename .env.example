# Database Configuration
DB_USER=youruser
DB_PASSWORD=yourpassword
DB_NAME=whoknows
DB_HOST=postgres
DB_PORT=5432

# Database Connection String (built from above variables)
CONN_STR=postgres://youruser:yourpassword@postgres:5432/whoknows?sslmode=disable

# For SQLite to Postgres Migration
SQLITE_DB_PATH=./src/whoknows.db

# Elasticsearch Configuration
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=elastic
ES_PASSWORD=changeme

# Web Server Configuration
PORT=8080
TEMPLATE_PATH=./src/frontend/templates/
STATIC_PATH=./src/frontend/static/

# Security
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# Initial Admin User (for migrations)
ADMIN_USER=admin
ADMIN_EMAIL=keamonk1@stud.kea.dk
ADMIN_PASS_HASH=5f4dcc3b5aa765d61d8327deb882cf99

# Application Environment
APP_ENV=development
LOG_LEVEL=debug

# Log
SEARCH_LOG_PATH=./src/backend/search.log

# Grafana (REQUIRED - no default for security)
GF_ADMIN_PASSWORD=your-secure-grafana-password

# External API Keys
OPENWEATHER_API_KEY=your-openweather-api-key-here
